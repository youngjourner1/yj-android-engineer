<Window
    x:Class="YJWebcam.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YJ Webcam Desktop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="NavView" Header="Dashboard" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard"/>
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings"/>
                <NavigationViewItem Content="Diagnostics" Icon="Assessment" Tag="diagnostics"/>
                <NavigationViewItem Content="Pair Device" Icon="Camera" Tag="pairing"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
