<Page
    x:Class="YJWebcam.Desktop.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="24">
        <TextBlock Text="Diagnostics & Metrics" FontSize="28" FontWeight="Bold"/>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Frame Rate" Foreground="Gray"/>
                    <TextBlock Text="59.8 FPS" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Network Latency" Foreground="Gray"/>
                    <TextBlock Text="18.2 ms" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Dropped Frames" Foreground="Gray"/>
                    <TextBlock Text="0 frames" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
