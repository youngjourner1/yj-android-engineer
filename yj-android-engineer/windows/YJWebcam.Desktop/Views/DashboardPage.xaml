<Page
    x:Class="YJWebcam.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <TextBlock Text="YJ Webcam Desktop" FontSize="28" FontWeight="Bold"/>
            <Border Background="#10B981" CornerRadius="12" Padding="8,4">
                <TextBlock Text="CONNECTED" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Video Preview Viewport -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" Margin="0,0,0,24">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="Gray"/>
                    <TextBlock Text="LIVE VIDEO STREAM FEED (1080p 60FPS)" Foreground="Gray" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Bar & Connect Controls -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="32">
                <StackPanel>
                    <TextBlock Text="FPS" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="59.8 / 60" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Bitrate" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="12.5 Mbps" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Latency" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="18 ms" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Toggle Stream" Style="{StaticResource AccentButtonStyle}" Padding="24,10"/>
                <Button Content="Driver Manager" Padding="16,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
